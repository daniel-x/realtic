{
  "name": "realtic",
  "version": "0.1.0",
  "description": "WebRTC mesh library with peer relays, fast liveness and connection recovery",
  "keywords": [
    "webrtc",
    "mesh",
    "p2p",
    "relay",
    "peer-to-peer",
    "datachannel",
    "signaling",
    "ice-restart"
  ],
  "license": "MIT OR Apache-2.0",
  "author": "Daniel Strecker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-x/realtic.git"
  },
  "homepage": "https://github.com/daniel-x/realtic#readme",
  "bugs": {
    "url": "https://github.com/daniel-x/realtic/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./log-forward": {
      "types": "./types/diag/log-forward.d.ts",
      "default": "./src/diag/log-forward.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "docs",
    "examples",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node test/integration/fast.js",
    "test:full": "node --test --test-concurrency=1 test/integration/direct/dir.test.js test/integration/relay/rel.test.js",
    "lint": "eslint src test examples",
    "types": "tsc -p tsconfig.json",
    "bundle": "esbuild src/index.js --bundle --format=esm --outfile=dist/realtic.js",
    "test:soak": "TEST_TIMINGS=${TEST_TIMINGS:-default} node --test test/integration/soak/soak.test.js",
    "spike": "node test/spikes/m0.js",
    "test:php": "REALTIC_SERVER=php node test/integration/fast.js",
    "prepublishOnly": "npm run lint && npm test && npm run types && git diff --exit-code types"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "turn-server": "^0.6.6",
    "typescript": "^5.9.3"
  }
}
